    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, service_type, task_title, default_owner_role, days_offset FROM ops_task_templates WHERE service_type = $1 ORDER BY days_offset ASC NULLS LAST",
        "options": {
          "queryReplacement": "={{ $('Webhook').first().json.body.service_type }}"
        }
      },
      "id": "co-node-03",
      "name": "Fetch Task Templates",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [480, 480],
      "credentials": {
        "postgres": {
          "id": "CBOP_PG_CRED_ID",
          "name": "CBOP Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT u.id FROM users u JOIN user_companies uc ON uc.user_id = u.id WHERE u.role = 'coo' AND uc.company_id = $1 LIMIT 1",
        "options": {
          "queryReplacement": "={{ $('Fetch Client').first().json.company_id }}"
        }
      },
      "id": "co-node-04",
      "name": "Find Default Owner",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [720, 300],
      "credentials": {
        "postgres": {
          "id": "CBOP_PG_CRED_ID",
          "name": "CBOP Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO ops_projects (company_id, name, owner_id, status, description) VALUES ($1, $2, $3, 'active', $4) RETURNING id, company_id, owner_id",
        "options": {
          "queryReplacement": "={{ $('Fetch Client').first().json.company_id + ',Onboarding: ' + $('Fetch Client').first().json.name + ',' + $('Find Default Owner').first().json.id + ',Auto-created by client_onboarding workflow for deal ' + $('Webhook').first().json.body.deal_id }}"
        }
      },
      "id": "co-node-05",
      "name": "Create Onboarding Project",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [960, 300],
      "credentials": {
        "postgres": {
          "id": "CBOP_PG_CRED_ID",
          "name": "CBOP Postgres"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const templates = $('Fetch Task Templates').all();\nconst project = $('Create Onboarding Project').first().json;\nconst companyId = project.company_id;\nconst projectId = project.id;\nconst ownerId = project.owner_id;\n\nif (!templates.length) return [];\n\nconst valueSets = templates.map((t, i) => {\n  const tmpl = t.json;\n  const due = tmpl.days_offset !== null\n    ? `NOW() + INTERVAL '${parseInt(tmpl.days_offset)} days'`\n    : 'NULL';\n  return `('${companyId}', '${projectId}', '${tmpl.task_title.replace(/'/g, \"''\")}', '${ownerId}', 'todo', 'medium', ${due})`;\n});\n\nconst sql = `INSERT INTO ops_tasks (company_id, project_id, title, owner_id, status, priority, due_date) VALUES ${valueSets.join(', ')}`;\n\nreturn [{ json: { sql, task_count: templates.length } }];"
      },
      "id": "co-node-06",
      "name": "Build Task Insert SQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $json.sql }}",
        "options": {}
      },
      "id": "co-node-07",
      "name": "Insert Tasks",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1440, 300],
      "credentials": {
        "postgres": {
          "id": "CBOP_PG_CRED_ID",
          "name": "CBOP Postgres"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://cbop-app:3000/api/internal/send-email",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: $('Fetch Client').first().json.email, subject: 'Welcome to Etherence — Your Onboarding is Ready', text: 'Hi ' + $('Fetch Client').first().json.name + ',\\n\\nWelcome aboard! Your onboarding has been set up and your dedicated team is ready to begin.\\n\\nIf you have any questions, reply to this email or reach out to your account manager.\\n\\nThank you for choosing Etherence.', html: '<p>Hi ' + $('Fetch Client').first().json.name + ',</p><p>Welcome aboard! Your onboarding has been set up and your dedicated team is ready to begin.</p><p>If you have any questions, reply to this email or reach out to your account manager.</p><p>Thank you for choosing Etherence.</p>' }) }}",
