# Server-only. Where THIS app's server-side code (get-cbop-session.ts) reaches
# the main CBOP API. In production, container-to-container on the shared
# Docker network (http://cbop-app:3000) - never the public hostname for
# server-to-server calls, that would depend on DNS/NPM being up for what
# should be an internal request. In local dev, the main app's dev port.
CBOP_API_URL=http://localhost:3003

# Client-visible (NEXT_PUBLIC_*, bundled into the browser). Where THIS app's
# browser-side code (api-client.ts) reaches the main CBOP API - must be the
# real public origin, since the browser can't resolve a Docker service name.
NEXT_PUBLIC_CBOP_API_URL=https://cbop.etherence.com

# Where "Continue with CBOP" sends an unauthenticated visitor to log in.
NEXT_PUBLIC_CBOP_LOGIN_URL=https://cbop.etherence.com/login

# This app's own public URL - passed as the `redirect` param on the login
# link above so the main app's login flow bounces back here after auth.
NEXT_PUBLIC_ACCOUNTING_URL=https://accounting.etherence.com
