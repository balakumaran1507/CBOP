    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.id, c.name, c.email, c.org_name, c.company_id, co.name AS company_name FROM sales_clients c JOIN companies co ON co.id = c.company_id WHERE c.id = $1",
        "options": {
          "queryReplacement": "={{ $json.body.client_id }}"
        }
      },
      "id": "co-node-02",
      "name": "Fetch Client",
      "type": "n8n-nodes-base.postgres",
