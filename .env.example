# Database
DATABASE_URL=postgresql://cbop_user:your_password@localhost:5432/cbop_v2
POSTGRES_USER=cbop_user
POSTGRES_PASSWORD=your_password

# better-auth
BETTER_AUTH_SECRET=your_secret_key_min_32_chars_required
# Extra allowed origins beyond cbop.etherence.com, comma-separated (e.g. a LAN IP for testing)
BETTER_AUTH_TRUSTED_ORIGINS=
# Set to .etherence.com ONLY once accounting.etherence.com is actually live.
# Leave unset in local dev - a `.etherence.com` cookie is never sent to `localhost`
# and setting this prematurely breaks login. See api/lib/auth.ts for the full reasoning.
BETTER_AUTH_COOKIE_DOMAIN=

# Hermes (AI Agents + Messaging - Telegram, WhatsApp, Discord, Slack)
HERMES_URL=http://127.0.0.1:18790
HERMES_API_KEY=your_hermes_api_key  # used for /send, /agent, /invoke, /complete endpoints
# Backward-compat aliases (remove once .env is updated):
# OPENCLAW_URL=http://127.0.0.1:18789
# OPENCLAW_API_KEY=your_openclaw_api_key

# Outline (SOPs) - Already running on homeserver
OUTLINE_URL=http://localhost:3000
OUTLINE_API_TOKEN=your_outline_api_token

# WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token

# n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your_n8n_password
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=your_n8n_webhook_secret
N8N_DB_NAME=n8n
N8N_URL=http://localhost:5678
# n8n production (these go in docker-compose env, not app .env)
# N8N_LOG_LEVEL=warn
# EXECUTIONS_DATA_SAVE_ON_ERROR=all
# EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
# EXECUTIONS_DATA_PRUNE=true
# EXECUTIONS_DATA_MAX_AGE=336

# AWS S3 Backup
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=cbop-backups

# Timezone
TIMEZONE=Asia/Kolkata

# Telegram Bot (for cbop_send_pdf_to_telegram MCP tool)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# MCP server - Hermes service account token
CBOP_MCP_TOKEN=cbop_mcp_secret_2026

# Hiring module - local LLM scoring via Ollama
# Ollama runs on a separate LAN machine (the one with RAM/GPU), NOT on this server.
# On the Ollama machine: install Ollama, run: OLLAMA_HOST=0.0.0.0 ollama serve
# Then pull the model: ollama pull gemma3:4b
# Set this to that machine's LAN IP, e.g. http://192.168.1.50:11434
OLLAMA_URL=http://192.168.1.50:11434
OLLAMA_MODEL=gemma3:4b

# Hiring module - Outline collection for intern wiki pages (optional)
OUTLINE_HIRING_COLLECTION_ID=

# n8n env vars needed for hiring workflows
# NABEELAH_TELEGRAM_ID=<nabeelah_telegram_chat_id>
# CBOP_URL=http://192.168.88.6:3003

# ── Email / SMTP (nodemailer - ALL CBOP outbound email) ──────────────────────
# Transport is Google Workspace SMTP per company. Each company's mail is sent
# with that company's own authenticated account so DKIM aligns (no spam).
# Deliverability depends on DNS - see docs/EMAIL_DELIVERABILITY.md (SPF/DKIM/DMARC).
#
# Default / transactional sender (auth mail, system mail, n8n /send-email):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=founders@cybercomctf.com
SMTP_PASS=your_gmail_app_password          # 16-char Google App Password (no spaces)
SMTP_FROM=CBOP Platform <founders@cybercomctf.com>
#
# Per-company senders. Naming: SMTP_USER_<ENV> / SMTP_PASS_<ENV> where <ENV>
# matches email_domains.smtp_env (CYBERCOM | OUANTUM | ZAPSTERS | ETHERENCE | ATTACKOS).
# A domain only sends if it is marked verified=true in the email_domains table.
SMTP_USER_CYBERCOM=founders@cybercomctf.com
SMTP_PASS_CYBERCOM=your_gmail_app_password
SMTP_USER_OUANTUM=founders@ouantum.com
SMTP_PASS_OUANTUM=your_gmail_app_password
SMTP_USER_ZAPSTERS=founders@zapsters.in
SMTP_PASS_ZAPSTERS=your_gmail_app_password
# Not verified yet (forwarding-only domains) - leave as placeholders until their
# Google Workspace + DNS is live, then flip email_domains.verified = true.
SMTP_USER_ETHERENCE=founders@etherence.com
SMTP_PASS_ETHERENCE=PLACEHOLDER_SET_REAL_APP_PASSWORD
SMTP_USER_ATTACKOS=founders@attackos.com
SMTP_PASS_ATTACKOS=PLACEHOLDER_SET_REAL_APP_PASSWORD
# Legacy aliases still read as a fallback (SMTP_OUANTUM_USER / SMTP_ZAPSTERS_USER):
SMTP_OUANTUM_USER=founders@ouantum.com
SMTP_OUANTUM_PASS=your_gmail_app_password
SMTP_ZAPSTERS_USER=founders@zapsters.in
SMTP_ZAPSTERS_PASS=your_gmail_app_password

# Amazon SES - shared bulk-campaign transport (see docs/EMAIL_DELIVERABILITY.md §7).
# Only used for domains marked provider='ses' in email_domains; Workspace mailboxes
# above are untouched. SES SMTP creds are generated once in the SES console under
# "SMTP settings" - they are NOT your AWS IAM access key/secret used for S3 backups.
# One SES SMTP user can send as any identity verified in that AWS account/region.
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USER=your_ses_smtp_username
SES_SMTP_PASS=your_ses_smtp_password

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3003

# Blog & SEO module - Google OAuth (Search Console + GA4 share one consent screen,
# two scopes requested together). Create a project at console.cloud.google.com,
# enable "Search Console API" + "Google Analytics Data API", create an OAuth 2.0
# Client ID (Web application), add the redirect URI below to its authorized list.
# Leave unset to run with the SEO module's Google features disabled (degrades
# gracefully - connections just show "not configured", nothing throws).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=  # defaults to NEXT_PUBLIC_APP_URL + /api/seo/oauth/callback if unset
# PageSpeed Insights API key - separate from OAuth, just an API key, no consent
# flow. Create at console.cloud.google.com under "PageSpeed Insights API".
GOOGLE_PAGESPEED_API_KEY=

# Social Media Manager - LinkedIn OAuth (see docs/SOCIAL_Build_Plan.md's
# "Social Media Manager" section). Create an app at developer.linkedin.com,
# add the "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect"
# products (self-serve, no review - covers personal-profile posting), add the
# redirect URI below to the app's authorized list. Company-page posting needs
# the separate, gated Community Management API - same client ID/secret, just
# apply for that product once you're ready (weeks-months approval, see the
# build plan doc). Leave unset to run with LinkedIn connect buttons disabled -
# degrades gracefully, nothing throws.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=  # defaults to NEXT_PUBLIC_APP_URL + /api/social/linkedin/callback if unset

# ── Ops alerts (platform defaults) ───────────────────────────────────────────
# Who gets operational alerts (document batch finished, campaign auto-paused)
# and is used as the ops/team-lead contact in template previews.
# Per-company values live in companies.ops_alert_telegram_id / ops_alert_email
# (migration 059) and always win; these are only the fallback for a company
# that has not set one. See api/lib/ops-alerts.ts.
OPS_ALERT_TELEGRAM_ID=
OPS_ALERT_EMAIL=
